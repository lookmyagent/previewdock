{
  "name": "previewdock-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lookmyagent/previewdock.git"
  },
  "homepage": "https://github.com/lookmyagent/previewdock#readme",
  "bugs": {
    "url": "https://github.com/lookmyagent/previewdock/issues"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm build:surfaces && pnpm --filter @previewdock/site dev",
    "dev:docs": "pnpm --filter @previewdock/docs dev",
    "dev:playground": "pnpm --filter @previewdock/playground dev",
    "build:surfaces": "pnpm --filter @previewdock/docs build && pnpm --filter @previewdock/playground build",
    "build": "pnpm -r --filter './packages/**' build && pnpm --filter @previewdock/site build && pnpm run build:surfaces && node scripts/assemble-site.mjs",
    "deploy:production": "bash scripts/deploy-production.sh",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@vitejs/plugin-vue": "^5.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4",
    "vue": "^3.5.16",
    "vue-tsc": "^2.2.10"
  },
  "description": "A local-first, framework-agnostic file preview runtime for the browser.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "prettier": "^2.8.8"
  },
  "keywords": [],
  "author": ""
}
