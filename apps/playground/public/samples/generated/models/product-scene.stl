solid PreviewDockStand
  facet normal 0 0 -1
    outer loop
      vertex -1 0 -1
      vertex 0 1.8 0
      vertex 1 0 -1
    endloop
  endfacet
  facet normal 1 0 1
    outer loop
      vertex 1 0 -1
      vertex 0 1.8 0
      vertex 1 0 1
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex 1 0 1
      vertex 0 1.8 0
      vertex -1 0 1
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex -1 0 1
      vertex 0 1.8 0
      vertex -1 0 -1
    endloop
  endfacet
endsolid PreviewDockStand
