<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <contributor><authoring_tool>PreviewDock sample generator</authoring_tool></contributor>
    <unit name="meter" meter="1"/>
    <up_axis>Y_UP</up_axis>
  </asset>
  <library_effects>
    <effect id="blue-effect">
      <profile_COMMON>
        <technique sid="common">
          <lambert><diffuse><color>0.192 0.369 0.906 1</color></diffuse></lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_materials>
    <material id="blue-material" name="PreviewDock Blue">
      <instance_effect url="#blue-effect"/>
    </material>
  </library_materials>
  <library_geometries>
    <geometry id="stand" name="PreviewDock Stand">
      <mesh>
        <source id="stand-positions">
          <float_array id="stand-positions-array" count="15">-1 0 -1 1 0 -1 1 0 1 -1 0 1 0 1.8 0</float_array>
          <technique_common>
            <accessor source="#stand-positions-array" count="5" stride="3">
              <param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="stand-vertices"><input semantic="POSITION" source="#stand-positions"/></vertices>
        <triangles count="6" material="blue-material">
          <input semantic="VERTEX" source="#stand-vertices" offset="0"/>
          <p>0 1 2 0 2 3 0 4 1 1 4 2 2 4 3 3 4 0</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="PreviewDock Product Scene">
      <node id="Stand" name="PreviewDock Stand">
        <instance_geometry url="#stand">
          <bind_material><technique_common><instance_material symbol="blue-material" target="#blue-material"/></technique_common></bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
