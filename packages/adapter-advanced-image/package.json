{
  "name": "@previewdock/adapter-advanced-image",
  "version": "0.1.0",
  "description": "Browser-side TIFF, TGA, and PSD preview adapter for PreviewDock",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/lookmyagent/previewdock.git", "directory": "packages/adapter-advanced-image" },
  "homepage": "https://github.com/lookmyagent/previewdock#readme",
  "bugs": { "url": "https://github.com/lookmyagent/previewdock/issues" },
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/manifest.ts --format esm --dts --clean --splitting",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@previewdock/core": "workspace:*",
    "ag-psd": "^31.0.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.180.0"
  }
}
