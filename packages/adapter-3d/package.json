{
  "name": "@previewdock/adapter-3d",
  "version": "0.1.0",
  "description": "Browser-side 3D model viewer for PreviewDock",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lookmyagent/previewdock.git",
    "directory": "packages/adapter-3d"
  },
  "homepage": "https://github.com/lookmyagent/previewdock#readme",
  "bugs": {
    "url": "https://github.com/lookmyagent/previewdock/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/manifest.ts --format esm --dts --clean --splitting",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@previewdock/core": "workspace:*",
    "dxf-parser": "1.1.2",
    "occt-import-js": "0.0.23",
    "rhino3dm": "8.17.0",
    "three": "^0.185.1",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@types/three": "^0.180.0"
  }
}
