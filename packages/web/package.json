{
  "name": "@previewdock/web",
  "version": "0.2.0",
  "description": "Framework-neutral DOM and Web Component host for PreviewDock",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/lookmyagent/previewdock.git", "directory": "packages/web" },
  "homepage": "https://github.com/lookmyagent/previewdock#readme",
  "bugs": { "url": "https://github.com/lookmyagent/previewdock/issues" },
  "type": "module",
  "sideEffects": false,
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --splitting",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@previewdock/core": "workspace:*"
  }
}
