{
  "name": "@previewdock/preset-all",
  "version": "0.2.0",
  "description": "Official all-format lazy adapter preset for PreviewDock",
  "keywords": [
    "previewdock",
    "file-preview",
    "vue",
    "office",
    "pdf"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lookmyagent/previewdock.git",
    "directory": "packages/preset-all"
  },
  "homepage": "https://github.com/lookmyagent/previewdock#readme",
  "bugs": {
    "url": "https://github.com/lookmyagent/previewdock/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --splitting",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@previewdock/core": "workspace:*",
    "@previewdock/preset-3d-cad": "workspace:*",
    "@previewdock/preset-archives": "workspace:*",
    "@previewdock/preset-diagrams": "workspace:*",
    "@previewdock/preset-documents": "workspace:*",
    "@previewdock/preset-images": "workspace:*",
    "@previewdock/preset-media": "workspace:*",
    "@previewdock/preset-text-data": "workspace:*"
  }
}
