{
  "name": "@previewdock/assets",
  "version": "0.2.0",
  "description": "Self-hosted PreviewDock runtime asset manifest and copy CLI",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/lookmyagent/previewdock.git", "directory": "packages/assets" },
  "homepage": "https://github.com/lookmyagent/previewdock#readme",
  "bugs": { "url": "https://github.com/lookmyagent/previewdock/issues" },
  "type": "module",
  "files": ["dist", "bin", "NOTICE.md"],
  "publishConfig": { "access": "public" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "previewdock-copy-assets": "./bin/previewdock-copy-assets.mjs"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "libarchive.js": "^2.0.2",
    "occt-import-js": "^0.0.23",
    "rhino3dm": "^8.17.0",
    "web-ifc": "^0.0.77"
  },
  "devDependencies": {
    "@types/node": "^22.15.29"
  }
}
