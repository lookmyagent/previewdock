{
  "name": "@previewdock/vue",
  "version": "0.2.0",
  "description": "Vue 3 host component for PreviewDock",
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "git+https://github.com/lookmyagent/previewdock.git", "directory": "packages/vue" },
  "homepage": "https://github.com/lookmyagent/previewdock#readme",
  "bugs": { "url": "https://github.com/lookmyagent/previewdock/issues" },
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/vue/src/index.d.ts",
      "import": "./dist/previewdock.js"
    },
    "./style.css": "./dist/previewdock.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@previewdock/core": "workspace:*",
    "@previewdock/web": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  }
}
